{
  "name": "n8n-nodes-intervenio",
  "version": "0.1.3",
  "description": "Simple and efficient: interven.io filters traffic sent to LLMs. Reduce token costs, redact sensitive information, and gain insights on usage.",
  "license": "MIT",
  "homepage": "https://interven.io",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "interven.io",
    "email": "development@roderick.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roderick-io/n8n-nodes-intervenio.git"
  },
  "bugs": {
    "url": "https://github.com/roderick-io/n8n-nodes-intervenio/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/IntervenioOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Intervenio/Intervenio.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
